{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Miniature Repainting",
  "version": "0.1.0",
  "identifier": "com.ai_miniature.repainting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Miniature Repainting",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": [
      "../python/**/*",
      "../docs/TECHNICAL_STACK_DEFINITION.md"
    ]
  }
}
